class Solution {
    public String smallestPalindrome(String s) {
        int n = s.length();
        int[] cnt = new int[26];
        for (int i = 0; i < n / 2; i++) cnt[s.charAt(i) - 'a']++;

        StringBuilder half = new StringBuilder();
        for (int c = 0; c < 26; c++) {
            for (int k = 0; k < cnt[c]; k++) half.append((char)('a' + c));
        }

        StringBuilder result = new StringBuilder(half);
        if (n % 2 == 1) result.append(s.charAt(n / 2));
        result.append(half.reverse());

        return result.toString();
    }
}
