package Javalab;
// java program to perform matrix multiplication
// note to work with matrices we have have to work with 2d arrays
// creating main class
public class MatrixMulDemo {
// main method
	public static void main(String[] args) {
		
		// create 2d int arrays mat A 3x3 mat
		int[][] A = {{1,2,3},
			       	{4,5,6},
				    {7,8,9}};	
		
		// create 2d array int arrays mat B 3x3 mat
		int[][] B = {{4,5,6},
			     	{1,2,3},
			    	{2,3,4}};
	
	// create 2d int array initially filled with zeroes 
		int[][] C = new int[3][3]; // creating array by specifying its size first and later qssign val to its elmnts 
		
		// implement the logic for multiplying two matrices a and b 
		for(int i=0;i<3;i++){
			for(int j=0;j<3;j++){
				C[i][j] = 0;			
		for(int k=0;k<3;k++){
			C[i][j] = C[i][j] + (A[i][k] * B[k][j]); // logic for matmul
			
	}			
	}
	}
		//iterate over an created 2d array C: mat C
		for(int i = 0;i<3;i++){
			for(int j=0;j<3;j++) {
				System.out.print(C[i][j]+" ");
				
			}
			System.out.println();
		}
	
		
	}
	}


