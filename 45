import java.util.ArrayDeque;
import java.util.Deque;

public class Solution {
    public int[] maxSlidingWindow(int[] nums, int k) {
        if (nums == null || nums.length == 0) {
            return new int[0];
        }
        
        int n = nums.length;
        int[] result = new int[n - k + 1];
        int ri = 0; // Index for result array
        
        // Deque stores indices of elements
        Deque<Integer> q = new ArrayDeque<>();
        
        for (int i = 0; i < n; i++) {
            // 1. Remove indices that are out of the current window bounds
            if (!q.isEmpty() && q.peek() < i - k + 1) {
                q.poll();
            }
            
            // 2. Maintain monotonic property (decreasing order of values)
            // Remove indices of elements smaller than the current element from the back
            while (!q.isEmpty() && nums[q.peekLast()] < nums[i]) {
                q.pollLast();
            }
            
            // 3. Add current element's index to the back
            q.offer(i);
            
            // 4. If window has reached size k, the front of queue is the maximum
            if (i >= k - 1) {
                result[ri++] = nums[q.peek()];
            }
        }
        
        return result;
    }
}
